.iu-box { width: 160rpx; height: 160rpx; border: 2rpx dashed #cfd4da; border-radius: 12rpx; overflow: hidden; background: #fff; display: flex; align-items: center; justify-content: center; }
.iu-img { width: 100%; height: 100%; }
.iu-empty { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.iu-plus { font-size: 44rpx; color: #b6bcc4; line-height: 1; }
.iu-tip { font-size: 20rpx; color: #b6bcc4; }
.iu-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.iu-act { font-size: 22rpx; color: #618137; }
.iu-del { color: #b23a2e; }
