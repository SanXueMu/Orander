<view class="orander-page {{themeClass}} {{fontClass}}">
  <view class="aurora">
    <view class="aurora-dot aurora-a"></view>
    <view class="aurora-dot aurora-b"></view>
    <view class="aurora-dot aurora-c"></view>
  </view>

  <navigation-bar title="我的订单" color="{{navColor}}" background="{{navBackground}}"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body orders-page-body">
      <view wx:if="{{profile}}" class="surface glass-blur orders-hero">
        <view class="section-kicker">MY ORDERS</view>
        <view class="section-title">{{profile.nickname}} 的订单</view>
        <view class="section-copy">茶饮与百货的每一笔都在这里，排队号与制作进度实时更新。</view>
        <view class="biz-tabs">
          <view class="biz-tab {{activeBiz === 'TEA' ? 'biz-tab-active' : ''}}" hover-class="press-dim" hover-stay-time="60" data-biz="TEA" bindtap="switchBiz">茶饮 · 鲜食</view>
          <view class="biz-tab {{activeBiz === 'MALL' ? 'biz-tab-active' : ''}}" hover-class="press-dim" hover-stay-time="60" data-biz="MALL" bindtap="switchBiz">喜茶百货</view>
        </view>
      </view>

      <view wx:if="{{!profile}}" class="surface empty-state">
        <view class="empty-icon empty-ticket"><view class="empty-ticket-line"></view><view class="empty-ticket-line"></view></view>
        <view class="section-title">还没有登记客人身份</view>
        <view class="section-copy">回首页先选头像、昵称和关系，之后订单才会归档到你名下。</view>
        <view hover-class="press-scale" hover-stay-time="60" class="button-primary empty-orders-button" bindtap="goMenu">回到菜单页</view>
      </view>

      <block wx:elif="{{hasOrders}}">
        <view wx:for="{{orderGroups}}" wx:key="label" wx:for-item="group" class="orders-group">
          <view class="orders-group-label text-thin">{{group.label}}</view>
          <view class="list-gap">
            <view wx:for="{{group.orders}}" wx:key="id" class="surface order-card" data-id="{{item.id}}" bindtap="openOrder" hover-class="press-dim" hover-stay-time="60">
              <view class="order-card-top">
                <view>
                  <view class="order-card-number">{{item.orderNumber}}</view>
                  <view class="order-card-date">{{item.createdText}}</view>
                </view>
                <view class="order-card-status order-status-{{item.statusTone}}">
                  <view class="order-status-dot"></view>
                  <view>{{item.statusText}}</view>
                </view>
              </view>
              <view class="order-card-preview">{{item.previewText}}</view>
              <view wx:if="{{item.queueText}}" class="order-card-queue">
                <text class="queue-label">排队号</text>
                <text class="num queue-value">{{item.queueText}}</text>
              </view>
              <view class="order-card-bottom">
                <view class="num order-card-total">{{item.totalText}}</view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view wx:else class="surface empty-state">
        <view class="empty-icon empty-ticket"><view class="empty-ticket-line"></view><view class="empty-ticket-line"></view></view>
        <view class="section-title">还没有下过单</view>
        <view class="section-copy">现在去菜单页点一桌，第一张回执就会在这里出现。</view>
        <view hover-class="press-scale" hover-stay-time="60" class="button-primary empty-orders-button" bindtap="goMenu">去点菜</view>
      </view>
    </view>
  </scroll-view>

</view>
