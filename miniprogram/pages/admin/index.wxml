<navigation-bar title="管理工作台" back="{{false}}"></navigation-bar>
<view class="admin-page">

  <view wx:if="{{!adminReady}}" class="gate">
    <view class="gate-card">
      <view class="gate-title">管理员验证</view>
      <view class="gate-desc">输入管理密码进入工作台</view>
      <input class="gate-input" password type="text" placeholder="管理密码" value="{{password}}" bindinput="onPasswordInput" />
      <view class="gate-btn {{password ? '' : 'gate-btn-dim'}}" bindtap="submitPassword">进入工作台</view>
    </view>
  </view>

  <block wx:else>
    <view class="dash">
      <view class="dash-cards">
        <view class="dash-card">
          <view class="num dash-num">{{todayGmvText}}</view>
          <view class="dash-label">今日营业额</view>
        </view>
        <view class="dash-card">
          <view class="num dash-num">{{todayOrders}}</view>
          <view class="dash-label">今日订单</view>
        </view>
        <view class="dash-card {{pendingRefundCount ? 'dash-card-warn' : ''}}" bindtap="goOrders" data-tab="refund">
          <view class="num dash-num">{{pendingRefundCount}}</view>
          <view class="dash-label">待审退款</view>
        </view>
        <view class="dash-card" bindtap="goQueue">
          <view class="num dash-num">{{makingCount}}</view>
          <view class="dash-label">制作中</view>
        </view>
      </view>

      <view class="dash-chart">
        <view class="panel-title">近 7 日</view>
        <view class="chart-row">
          <view wx:for="{{daily}}" wx:key="date" class="chart-col">
            <view class="chart-bar" style="height: {{item.barHeight}}rpx"></view>
            <view class="chart-date">{{item.date}}</view>
          </view>
        </view>
      </view>

      <view class="dash-todo">
        <view class="panel-title">待办</view>
        <view class="todo-row" bindtap="goOrders" data-tab="refund">
          <view class="todo-label">退款审批</view>
          <view class="todo-val {{pendingRefundCount ? 'todo-hot' : ''}}">{{pendingRefundCount ? pendingRefundCount + ' 单待处理' : '无待办'}}</view>
          <view class="todo-arrow">›</view>
        </view>
        <view class="todo-row" bindtap="goQueue">
          <view class="todo-label">制作队列</view>
          <view class="todo-val">{{queueCount ? queueCount + ' 单排队' : '空闲'}}</view>
          <view class="todo-arrow">›</view>
        </view>
        <view class="todo-row" bindtap="goOrders" data-tab="all">
          <view class="todo-label">全部订单</view>
          <view class="todo-val">{{totalOrders}} 单</view>
          <view class="todo-arrow">›</view>
        </view>
      </view>

      <view class="dash-top">
        <view class="panel-title">热销 TOP</view>
        <view wx:for="{{topDishes}}" wx:key="spuId" class="top-row">
          <view class="top-rank num">{{index + 1}}</view>
          <view class="top-name">{{item.name}}</view>
          <view class="num top-qty">x{{item.quantity}}</view>
        </view>
        <view wx:if="{{!topDishes.length}}" class="empty-panel">暂无销售数据</view>
      </view>
    </view>

    <view class="surface admin-menu">
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goSpus">
        <text>商品管理</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goOrders" data-tab="all">
        <text>订单中心</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goQueue">
        <text>制作队列</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goStores">
        <text>门店管理</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row admin-menu-row-last" hover-class="press-dim" hover-stay-time="60" bindtap="goPromote">
        <text>营销中心</text><text class="admin-menu-arrow">›</text>
      </view>
    </view>

    <view class="surface admin-menu">
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goMembers">
        <text>会员列表</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goContent">
        <text>内容管理</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goReviews">
        <text>评价审核</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goCs">
        <text>客服工作台</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goInvoices">
        <text>开票处理</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goLegacyUser">
        <text>花名册（旧）</text><text class="admin-menu-arrow">›</text>
      </view>
      <view class="admin-menu-row admin-menu-row-last" hover-class="press-dim" hover-stay-time="60" bindtap="goSettings">
        <text>系统设置</text><text class="admin-menu-arrow">›</text>
      </view>
    </view>

  </block>
</view>
