<view class="orander-page {{themeClass}} {{fontClass}} admin-page">
  <navigation-bar color="{{navColor}}" background="{{navBackground}}">
    <view slot="center" class="nav-title">管理</view>
  </navigation-bar>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body admin-page-body list-gap">
      <view class="surface admin-hero">
        <view>
          <view class="section-kicker">ADMIN</view>
          <view class="section-title admin-title">{{adminName}}</view>
        </view>
        <view class="admin-hero-actions">
          <view class="admin-business-toggle {{businessOpen ? 'business-open' : 'business-closed'}}" bindtap="toggleBusinessStatus">
            <view class="admin-business-dot"></view>
            <view class="admin-business-label">{{businessOpen ? '营业中' : '已暂停'}}</view>
          </view>
          <view hover-class="press-scale" hover-stay-time="60" class="menu-mini-action" bindtap="logout">退出</view>
        </view>
      </view>

      <view class="admin-tabs">
        <view hover-class="press-dim" hover-stay-time="60" class="chip {{activePanel === 'menu' ? 'chip-active' : ''}}" data-panel="menu" bindtap="switchPanel">菜单管理</view>
        <view hover-class="press-dim" hover-stay-time="60" class="chip {{activePanel === 'orders' ? 'chip-active' : ''}}" data-panel="orders" bindtap="switchPanel">订单</view>
        <view hover-class="press-dim" hover-stay-time="60" class="chip {{activePanel === 'stats' ? 'chip-active' : ''}}" data-panel="stats" bindtap="switchPanel">统计</view>
        <view hover-class="press-dim" hover-stay-time="60" class="chip {{activePanel === 'users' ? 'chip-active' : ''}}" data-panel="users" bindtap="switchPanel">用户管理</view>
      </view>

      <block wx:if="{{activePanel === 'orders'}}">
        <view wx:if="{{ordersLoading}}" class="surface admin-empty">加载中…</view>
        <view wx:elif="{{!orders.length}}" class="surface admin-empty">还没有订单</view>
        <view wx:else class="list-gap">
          <view wx:for="{{orders}}" wx:key="id" class="surface admin-card">
            <view class="admin-card-top">
              <view>
                <view class="admin-card-title">{{item.nickname}}</view>
                <view class="admin-card-copy">{{item.orderNumber}} · {{item.createdText}}</view>
              </view>
              <view class="admin-order-status {{item.status === 'completed' ? 'status-completed' : 'status-submitted'}}">{{item.statusText}}</view>
            </view>
            <view class="admin-card-copy">{{item.previewText}}</view>
            <view wx:if="{{item.note}}" class="admin-card-copy admin-order-note">备注：{{item.note}}</view>
            <view class="admin-card-actions user-card-actions">
              <view class="num admin-card-price">{{item.totalText}}</view>
              <view wx:if="{{item.canComplete}}" hover-class="press-scale" hover-stay-time="60" class="button-secondary mini-action" data-id="{{item.id}}" bindtap="completeOrder">标记完成</view>
            </view>
          </view>

          <view class="surface admin-orders-pager">
            <view hover-class="press-scale" hover-stay-time="60" class="button-ghost mini-action {{ordersPage <= 1 ? 'pager-disabled' : ''}}" bindtap="prevOrdersPage">上一页</view>
            <view class="admin-card-copy">{{ordersPage}} / {{ordersTotal > 0 ? (ordersTotal + ordersPageSize - 1) / ordersPageSize : 1}}</view>
            <view hover-class="press-scale" hover-stay-time="60" class="button-ghost mini-action {{ordersPage * ordersPageSize >= ordersTotal ? 'pager-disabled' : ''}}" bindtap="nextOrdersPage">下一页</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{activePanel === 'stats'}}">
        <view wx:if="{{!stats}}" class="surface admin-empty">暂无统计数据</view>
        <view wx:else class="list-gap">
          <view class="surface admin-stats-grid">
            <view class="admin-stats-item">
              <view class="num admin-stats-value">{{statsRevenueText}}</view>
              <view class="admin-stats-label">累计营收</view>
            </view>
            <view class="admin-stats-item">
              <view class="num admin-stats-value">{{stats.totalOrders}}</view>
              <view class="admin-stats-label">订单总数</view>
            </view>
            <view class="admin-stats-item">
              <view class="num admin-stats-value">{{stats.completedCount}}</view>
              <view class="admin-stats-label">已完成</view>
            </view>
            <view class="admin-stats-item">
              <view class="num admin-stats-value">{{stats.submittedCount}}</view>
              <view class="admin-stats-label">待完成</view>
            </view>
          </view>

          <view class="surface admin-card">
            <view class="section-kicker">TOP DISHES</view>
            <view class="section-title">菜品销量榜</view>
            <view wx:for="{{stats.topDishes}}" wx:key="dishId" class="admin-rank-row">
              <view class="admin-rank-index">{{index + 1}}</view>
              <view class="admin-card-title">{{item.name}}</view>
              <view class="admin-card-copy">售出 {{item.quantity}} 份</view>
            </view>
            <view wx:if="{{!stats.topDishes.length}}" class="admin-empty">还没有销量数据</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{activePanel === 'menu'}}">
        <view class="surface action-card admin-action-row">
          <scroll-view class="admin-category-strip" scroll-x enable-flex>
            <view class="admin-category-row">
              <view
                wx:for="{{categories}}"
                wx:key="*this"
                hover-class="press-dim" hover-stay-time="60" class="chip {{item === activeCategory ? 'chip-active' : ''}}"
                data-category="{{item}}"
                bindtap="switchCategory"
              >
                {{item}}
              </view>
            </view>
          </scroll-view>
          <view class="admin-side-actions">
            <view hover-class="press-scale" hover-stay-time="60" class="button-secondary add-dish-button" bindtap="goCreateDish">新增</view>
            <view hover-class="press-scale" hover-stay-time="60" class="button-secondary publish-dish-button" bindtap="publishMenuToCloud">发布</view>
          </view>
        </view>

        <view class="list-gap">
          <view wx:for="{{dishes}}" wx:key="id" class="swipe-shell" data-id="{{item.id}}" bindtouchstart="onDishTouchStart" bindtouchend="onDishTouchEnd">
            <view class="swipe-delete" data-id="{{item.id}}" bindtap="removeDish">删除</view>
            <view class="surface admin-card swipe-content {{swipedDishId === item.id ? 'swipe-open' : ''}}" bindtap="closeSwipe">
              <block wx:if="{{item.image}}">
                <image class="admin-dish-image" src="{{item.image}}" mode="aspectFill"></image>
              </block>
              <block wx:else>
                <view class="admin-dish-image-fallback" style="{{item.coverStyle}}">{{item.imageLabel}}</view>
              </block>

              <view class="admin-card-top">
                <view>
                  <view class="admin-card-title">{{item.name}}</view>
                  <view class="admin-card-copy">{{item.category}} · {{item.priceText}}</view>
                </view>
                <view class="admin-card-actions">
                  <view hover-class="press-scale" hover-stay-time="60" class="button-ghost mini-action" data-id="{{item.id}}" bindtap="goEditDish">编辑</view>
                </view>
              </view>
              <view class="admin-card-copy">{{item.description}}</view>
              <view class="admin-switch-row">
                <view class="admin-card-copy">{{item.soldOutLabel}}</view>
                <switch color="#111111" checked="{{item.availableChecked}}" data-id="{{item.id}}" bindchange="toggleDishAvailability"></switch>
              </view>
            </view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="list-gap">
          <view wx:for="{{members}}" wx:key="id" class="surface admin-card">
            <view class="admin-card-top">
              <view class="admin-member-main">
                <block wx:if="{{item.showAvatarImage}}">
                  <image class="admin-member-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"></image>
                </block>
                <block wx:else>
                  <view class="admin-member-avatar-fallback" style="{{item.avatarStyle}}">{{item.avatarLabel}}</view>
                </block>
                <view>
                  <view class="admin-card-title">{{item.nickname}}</view>
                  <view class="admin-card-copy">{{item.joinedText}}</view>
                </view>
              </view>
              <view class="num admin-card-price">{{item.ordersCount}} 单</view>
            </view>
            <view class="admin-card-copy">最近下单 {{item.lastOrderText}}</view>
            <view class="admin-card-actions user-card-actions">
              <view hover-class="press-scale" hover-stay-time="60" class="button-ghost mini-action" data-id="{{item.id}}" bindtap="goUserOrders">订单</view>
              <view hover-class="press-scale" hover-stay-time="60" class="button-ghost mini-action" data-id="{{item.id}}" bindtap="removeMemberRecord">删除</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
