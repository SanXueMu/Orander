<view class="orander-page {{themeClass}} {{fontClass}}">
  <navigation-bar title="我的" color="{{navColor}}" background="{{navBackground}}"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body profile-page-body list-gap">
      <!-- 未登录：引导卡 -->
      <view wx:if="{{!logged}}" class="surface profile-login-card" hover-class="press-dim" hover-stay-time="60" bindtap="goLogin">
        <view class="profile-login-copy">
          <view class="section-title">登录 Orander GO</view>
          <view class="section-copy">登录后解锁会员等级、优惠券和订单档案。</view>
        </view>
        <view class="profile-login-cta">去登录</view>
      </view>

      <!-- 已登录：身份卡 -->
      <block wx:else>
        <view class="surface member-card" hover-class="press-dim" hover-stay-time="60" bindtap="goProfileEdit">
          <view class="member-card-top">
            <image wx:if="{{showAvatarImage}}" class="member-avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="member-avatar">{{avatarLabel}}</view>
            <view class="member-id-copy">
              <view class="member-nickname">{{nickname}}</view>
              <view class="member-level-pill" hover-class="press-dim" hover-stay-time="60" catchtap="goMemberCard">{{levelName || '会员'}} ›</view>
            </view>
            <!-- 会员码占位（R7 接真实码） -->
            <view class="member-qr" aria-label="会员码" hover-class="press-dim" hover-stay-time="60" catchtap="goQrcode">
              <view class="member-qr-grid">
                <view class="qr-cell qr-on"></view><view class="qr-cell"></view><view class="qr-cell qr-on"></view>
                <view class="qr-cell"></view><view class="qr-cell qr-on"></view><view class="qr-cell"></view>
                <view class="qr-cell qr-on"></view><view class="qr-cell"></view><view class="qr-cell qr-on"></view>
              </view>
              <text>会员码</text>
            </view>
          </view>

          <view class="member-growth">
            <view class="member-growth-meta">
              <text>成长值 {{growthValue}}</text>
              <text>{{nextLevelName}} 还差 {{nextGap}}</text>
            </view>
            <view class="member-growth-bar">
              <view class="member-growth-fill" style="width: {{progressPercent}}%"></view>
            </view>
          </view>
        </view>

        <!-- 资产宫格 -->
        <view class="surface asset-grid">
          <view class="asset-cell" hover-class="press-dim" hover-stay-time="60" bindtap="goCoupons">
            <view class="num asset-num">{{couponCount}}</view>
            <view class="asset-label">优惠券</view>
          </view>
          <view class="asset-cell" hover-class="press-dim" hover-stay-time="60" bindtap="goBenefits" data-target="gold">
            <view class="num asset-num {{hasGoldCard ? 'gold-text' : ''}}">{{hasGoldCard ? '已开' : '金喜'}}</view>
            <view class="asset-label">金喜卡</view>
          </view>
          <view class="asset-cell" hover-class="press-dim" hover-stay-time="60" bindtap="goWallet">
            <view class="num asset-num">{{walletText}}</view>
            <view class="asset-label">钱包</view>
          </view>
          <view class="asset-cell" hover-class="press-dim" hover-stay-time="60" bindtap="goWallet">
            <view class="num asset-num">{{points}}</view>
            <view class="asset-label">积分</view>
          </view>
        </view>

        <!-- 功能入口 -->
        <view class="surface menu-panel">
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goOrders">
            <text>我的订单</text><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goBenefits">
            <text>会员福利</text><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goRedeem">
            <text>兑换中心</text><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goReviewsMine">
            <text>我的评价</text><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goNotifications">
            <view class="menu-row-left"><text>消息通知</text><text wx:if="{{unread > 0}}" class="menu-badge num">{{unread}}</text></view><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goCs">
            <text>在线客服</text><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goGroupmeal">
            <text>团餐预订</text><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goInvoice">
            <text>发票助手</text><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goMore">
            <text>更多</text><text class="menu-arrow">›</text>
          </view>
          <view class="menu-row menu-row-last" hover-class="press-dim" hover-stay-time="60" bindtap="goSettings">
            <text>设置</text><text class="menu-arrow">›</text>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>

  <visitor-tab-bar active="mine"></visitor-tab-bar>
</view>
