<view class="orander-page {{themeClass}} {{fontClass}}">
  <navigation-bar title="条款与政策" color="{{navColor}}" background="{{navBackground}}"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body list-gap">
      <view wx:if="{{!items.length && !loading}}" class="surface empty-panel">暂无条款内容</view>
      <view wx:for="{{items}}" wx:key="id" class="surface pol-row" hover-class="press-dim" hover-stay-time="60" data-id="{{item.id}}" bindtap="goDetail">
        <view>
          <text>{{item.title}}</text>
          <view wx:if="{{item.version}}" class="pol-version">{{item.version}}</view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </scroll-view>
</view>
