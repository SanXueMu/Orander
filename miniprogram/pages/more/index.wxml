<view class="orander-page {{themeClass}} {{fontClass}}">
  <navigation-bar title="更多" color="{{navColor}}" background="{{navBackground}}"></navigation-bar>
  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body list-gap more-body">
      <view class="surface menu-panel">
        <view class="menu-row" hover-class="press-dim" hover-stay-time="60" bindtap="goSettings">
          <text>设置</text><text class="menu-arrow">›</text>
        </view>
        <view class="menu-row menu-row-last" hover-class="press-dim" hover-stay-time="60" bindtap="goPolicies">
          <text>政策条款</text><text class="menu-arrow">›</text>
        </view>
      </view>
      <view class="more-slogan">new style tea, by inspiration</view>
    </view>
  </scroll-view>
</view>
