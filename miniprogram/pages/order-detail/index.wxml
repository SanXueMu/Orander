<view class="orander-page {{themeClass}} {{fontClass}}">
  <view class="aurora">
    <view class="aurora-dot aurora-a"></view>
    <view class="aurora-dot aurora-b"></view>
    <view class="aurora-dot aurora-c"></view>
  </view>

  <navigation-bar title="订单详情" color="{{navColor}}" background="{{navBackground}}"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y>
    <view wx:if="{{order}}" class="page-body detail-page-body list-gap">
      <view class="surface glass-blur detail-summary-card">
        <view class="detail-summary-top">
          <view>
            <view class="detail-order-number">{{order.orderNumber}}</view>
            <view class="detail-order-date">{{order.receiptDate}}</view>
          </view>
          <view class="detail-order-status">
            <view class="detail-status-dot"></view>
            <view>{{order.statusText}}</view>
          </view>
        </view>

        <!-- 排队号大字（已支付/制作中） -->
        <view wx:if="{{order.isPaidOrMaking}}" class="queue-hero">
          <text class="queue-hero-label">当前排队号</text>
          <text class="num queue-hero-number">{{order.queueNo}} 号</text>
        </view>

        <!-- 状态时间线 -->
        <view class="status-timeline">
          <view wx:for="{{order.timeline}}" wx:key="code" class="timeline-step {{item.done ? 'timeline-step-done' : ''}}">
            <view class="timeline-dot"></view>
            <view class="timeline-label">{{item.label}}</view>
          </view>
        </view>

        <view class="detail-guest-row">
          <text>Guest</text>
          <text>{{order.nickname}} / {{order.relationLabel}}</text>
        </view>
        <view class="detail-guest-row">
          <text>Total</text>
          <text>{{order.totalText}}</text>
        </view>
        <view wx:if="{{order.note}}" class="detail-note">备注：{{order.note}}</view>

        <!-- 待支付/进行中操作区 -->
        <view wx:if="{{order.canPayNow || order.canRefund}}" class="detail-action-row">
          <view wx:if="{{order.canPayNow}}" hover-class="press-scale" hover-stay-time="60" class="button-primary detail-action-main {{paying ? 'action-busy' : ''}}" bindtap="payNow">{{paying ? '支付中…' : '去支付'}}</view>
          <view wx:if="{{order.canRefund}}" hover-class="press-dim" hover-stay-time="60" class="button-ghost detail-action-ghost" bindtap="applyRefund">申请退款</view>
        </view>
      </view>

      <view class="surface detail-items-card">
        <view class="section-kicker">ORDER ITEMS</view>
        <view wx:for="{{order.lines}}" wx:key="dishId" class="detail-item-row">
          <view>
            <view class="detail-item-name">{{item.name}}</view>
            <view wx:if="{{item.specText}}" class="detail-item-spec">{{item.specText}}</view>
            <view class="detail-item-meta">{{item.quantity}} x {{item.priceText}}</view>
          </view>
          <view class="detail-item-subtotal">{{item.subtotalText}}</view>
        </view>
      </view>

      <view class="surface review-card">
        <view class="section-kicker">REVIEW</view>
        <view class="section-title review-title">给这单留个评价</view>
        <view class="review-rating-row">
          <view
            wx:for="{{ratingOptions}}"
            wx:key="*this"
            class="review-rating-chip {{item === rating ? 'review-rating-chip-active' : ''}}"
            data-rating="{{item}}"
            bindtap="chooseRating"
          >
            {{item}} 星
          </view>
        </view>
        <textarea class="field-textarea review-input" maxlength="160" placeholder="例如：回锅还想点哪道菜，或者今天这桌气氛如何。" value="{{comment}}" bindinput="onCommentInput"></textarea>
        <view hover-class="press-scale" hover-stay-time="60" class="button-primary review-button" bindtap="submitReview">保存评价</view>
      </view>
    </view>
  </scroll-view>
</view>
