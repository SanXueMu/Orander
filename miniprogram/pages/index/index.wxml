<view class="orander-page {{themeClass}} {{fontClass}} login-page">
  <view class="aurora">
    <view class="aurora-dot aurora-a"></view>
    <view class="aurora-dot aurora-b"></view>
    <view class="aurora-dot aurora-c"></view>
  </view>

  <navigation-bar back="{{canBack}}" color="{{navColor}}" background="{{navBackground}}">
    <view slot="center" class="nav-title">Orander</view>
  </navigation-bar>

  <view class="login-shell">
    <view class="surface glass-blur login-card">
      <view class="login-brand-row">
        <view class="login-brand">OR</view>
        <view class="login-brand-glyph"></view>
      </view>
      <view class="login-title">Orander</view>
      <view class="login-tagline">家常菜 · 今日点 · 明日尝</view>

      <view class="role-row">
        <view
          wx:for="{{roleTabs}}"
          wx:key="id"
          hover-class="press-scale" hover-stay-time="60" class="role-pill {{item.id === activeRole ? 'role-pill-active' : ''}}"
          data-role="{{item.id}}"
          bindtap="chooseRole"
        >
          {{item.label}}
        </view>
      </view>

      <view wx:if="{{activeRole === 'admin'}}" class="field-block login-field">
        <input class="field-input" password placeholder="管理员密码" value="{{adminPassword}}" bindinput="onPasswordInput" />
      </view>

      <view hover-class="press-scale" hover-stay-time="60" class="button-primary login-button" bindtap="login">微信登录</view>
      <view wx:if="{{showDebugLogin}}" hover-class="press-scale" hover-stay-time="60" class="button-ghost debug-button" bindtap="debugLogin">调试进入</view>

      <view wx:if="{{sessionHint}}" class="session-actions">
        <view hover-class="press-scale" hover-stay-time="60" class="button-ghost session-button" bindtap="continueSession">继续 {{sessionHint}}</view>
        <view class="session-link" bindtap="resetSession">退出</view>
      </view>
    </view>
  </view>
</view>
