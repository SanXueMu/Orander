<view class="orander-page {{themeClass}} {{fontClass}}">
  <navigation-bar title="Orander GO" color="{{navColor}}" background="{{navBackground}}"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y>
    <view class="page-body home-page-body with-tabbar">

      <view class="home-topline fade-in-up">
        <text class="home-topline-date">{{dateText}}</text>
        <text class="home-topline-greet">{{greetingText}}</text>
      </view>

      <view class="home-entry-row fade-in-up-late">
        <view class="surface home-entry-card" hover-class="press-scale" hover-stay-time="60" bindtap="goPickup">
          <view class="home-entry-title">到店取</view>
          <view class="home-entry-copy">到店自提 · 免排队</view>
          <view class="home-entry-arrow">›</view>
        </view>
        <view class="surface home-entry-card" hover-class="press-scale" hover-stay-time="60" bindtap="goDelivery">
          <view class="home-entry-title">喜外送</view>
          <view class="home-entry-copy">外送到家 · 足不出户</view>
          <view class="home-entry-arrow">›</view>
        </view>
      </view>


      <!-- 海报轮播（CMS 活动排期驱动，R8 海报化）：白底画布 / 主视觉大图 / 细线进度指示器 -->
      <view class="poster-stage fade-in-up">
        <swiper class="poster-swiper" current="{{posterCur}}" circular autoplay interval="5000" bindchange="onPosterChange">
          <block wx:for="{{posters}}" wx:key="key">
            <swiper-item>
              <view class="poster-card {{item.heroImage ? 'poster-photo' : 'poster-tone-' + item.tone}}">
                <image wx:if="{{item.heroImage}}" class="poster-img" src="{{item.heroImage}}" mode="aspectFill" />
                <view wx:if="{{item.heroImage}}" class="poster-img-veil"></view>
                <view wx:else class="poster-doodle" aria-hidden="true">
                  <view class="poster-doodle-ring"></view>
                  <view class="poster-doodle-dot poster-doodle-dot-a"></view>
                  <view class="poster-doodle-dot poster-doodle-dot-b"></view>
                </view>
                <view class="poster-body">
                  <view wx:if="{{item.kicker}}" class="poster-kicker">{{item.kicker}}</view>
                  <view class="poster-title">{{item.title}}</view>
                  <view wx:if="{{item.subtitle}}" class="poster-sub">{{item.subtitle}}</view>
                  <view wx:if="{{item.ctaText}}" class="poster-cta" hover-class="press-scale" hover-stay-time="60" catchtap="goPickup">{{item.ctaText}}</view>
                </view>
                <view wx:if="{{item.badge}}" class="poster-badge">{{item.badge}}</view>
              </view>
            </swiper-item>
          </block>
        </swiper>
        <view wx:if="{{posters.length > 1}}" class="poster-progress">
          <view class="poster-progress-track">
            <view class="poster-progress-bar" style="width: {{posterProgress}}%"></view>
          </view>
        </view>
        <view class="poster-chevron" aria-hidden="true"></view>
      </view>

      <view class="home-slogan fade-in-up-late">new style tea, by inspiration</view>
    </view>
  </scroll-view>

  <visitor-tab-bar active="home"></visitor-tab-bar>
</view>
