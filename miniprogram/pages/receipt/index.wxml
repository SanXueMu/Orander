<view class="orander-page {{themeClass}} {{fontClass}} waiting-page">
  <view class="aurora">
    <view class="aurora-dot aurora-a"></view>
    <view class="aurora-dot aurora-b"></view>
    <view class="aurora-dot aurora-c"></view>
  </view>

  <navigation-bar color="{{navColor}}" background="{{navBackground}}">
    <view slot="center" class="nav-title">等候中</view>
  </navigation-bar>

  <scroll-view class="page-scroll" scroll-y>
    <view wx:if="{{order}}" class="page-body receipt-page-body list-gap fade-in-up">
      <view class="surface glass-blur waiting-card">
        <view class="waiting-ring">
          <view class="waiting-ring-core"></view>
        </view>
        <view class="waiting-title">{{order.statusText}}</view>
        <view wx:if="{{order.queueNo}}" class="receipt-queue">
          <text class="receipt-queue-label">排队号</text>
          <text class="num receipt-queue-number">{{order.queueNo}} 号</text>
        </view>
        <view class="num waiting-number">{{order.orderNumber}}</view>
        <view class="waiting-time">{{createdText}}</view>

        <view class="waiting-status-row">
          <block wx:for="{{statusSteps}}" wx:key="label">
            <view wx:if="{{index > 0}}" class="waiting-step-line {{item.active ? 'waiting-step-line-active' : ''}}"></view>
            <view class="waiting-step {{item.active ? 'waiting-step-active' : ''}}">{{item.label}}</view>
          </block>
        </view>
      </view>

      <view class="surface glass-blur waiting-summary fade-in-up-late">
        <view wx:for="{{order.lines}}" wx:key="dishId" class="waiting-line">
          <view>
            <view class="waiting-line-name">{{item.name}}</view>
            <view class="waiting-line-meta">{{item.quantity}} x {{item.priceText}}</view>
          </view>
          <view class="num waiting-line-price">{{item.subtotalText}}</view>
        </view>

        <view class="waiting-total-row">
          <view>合计</view>
          <view class="num waiting-total-amount">{{totalText}}</view>
        </view>

        <view class="receipt-signature text-thin">今日由 {{chefName}} 掌勺</view>
      </view>

      <view class="button-row receipt-buttons">
        <view hover-class="press-scale" hover-stay-time="60" class="button-ghost receipt-button" bindtap="goProfile">我的</view>
        <view hover-class="press-scale" hover-stay-time="60" class="button-primary receipt-button" bindtap="backMenu">返回菜单</view>
      </view>
    </view>
  </scroll-view>
</view>
